# Backend environment — copy to `.env` and fill in
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Direct Postgres password (only needed for psql / DB tooling, not the API)
SUPABASE_DB_PASSWORD=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Supabase Auth: provider callback endpoint + allowed deep-link redirect URLs.
# These are registered under Authentication → URL Configuration in the dashboard.
SUPABASE_AUTH_REDIRECT_URL=https://<project>.supabase.co/auth/v1/callback
DATASCOPE_REDIRECT_URLS=datascope://reset-password,datascope://auth-redirect,datascope://auth-confirmed

PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
