# Supabase — public keys are safe in the browser bundle
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Supabase Auth: provider callback endpoint + allowed deep-link redirect URLs,
# registered under Authentication → URL Configuration in the dashboard.
NEXT_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=https://<project>.supabase.co/auth/v1/callback
NEXT_PUBLIC_DATASCOPE_REDIRECT_URLS=datascope://reset-password,datascope://auth-redirect,datascope://auth-confirmed

# Backend — server-side only (Railway internal URL, e.g. http://backend:8000
# or https://<service>.up.railway.app). Never expose in the browser.
BACKEND_URL=https://<backend-service>.up.railway.app

# Paddle (browser checkout)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=<paddle-client-token>
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=pri_<price-id>
